{
  "productName": "1TXT",
  "appId": "io.github.airdropdogs.1txt",
  "copyright": "Copyright © 2026 airdropdogs. Forked from Simplenote (Automattic), GPL-2.0.",
  "directories": {
    "output": "./release",
    "buildResources": "./resources"
  },
  "files": ["desktop", "dist", "shared"],
  "asar": true,
  "publish": null,
  "mac": {
    "icon": "./resources/images/app-icon.icns",
    "category": "public.app-category.productivity",
    "artifactName": "1TXT-macOS-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": ["universal"]
      },
      {
        "target": "zip",
        "arch": ["universal"]
      }
    ],
    "mergeASARs": false,
    "identity": null
  },
  "dmg": {
    "title": "1TXT Installer",
    "artifactName": "1TXT-macOS-${version}.${ext}",
    "icon": "./resources/images/dmg-icon.icns",
    "iconSize": 150,
    "background": "./resources/images/dmg-background.png",
    "contents": [
      {
        "x": 480,
        "y": 240,
        "type": "link",
        "path": "/Applications"
      },
      {
        "x": 130,
        "y": 240,
        "type": "file"
      }
    ]
  },
  "win": {
    "icon": "resources/images/simplenote.ico",
    "artifactName": "1TXT-${version}-win-${arch}.${ext}",
    "target": [
      {
        "target": "zip",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "1TXT-Setup-${version}-${arch}.${ext}",
    "deleteAppDataOnUninstall": false,
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "1TXT",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "linux": {
    "artifactName": "1TXT-linux-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "synopsis": "Open-source Markdown notes with Supabase sync",
    "category": "Utility",
    "executableName": "1txt",
    "desktop": {
      "Name": "1TXT",
      "Comment": "Markdown notes with Supabase sync",
      "GenericName": "Note Taking Application",
      "Type": "Application",
      "Icon": "1txt",
      "StartupNotify": true,
      "Categories": "Utility;Office"
    },
    "vendor": "airdropdogs",
    "maintainer": "airdropdogs"
  },
  "deb": {
    "compression": "gz"
  }
}
