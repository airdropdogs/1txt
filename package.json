{
  "name": "1txt",
  "description": "Open-source minimalist Markdown notes with live preview (Typora-style) and free multi-device sync. A modern, Supabase-powered rewrite of Simplenote — a lightweight open-source alternative to Notion, Evernote, and Bear.",
  "author": {
    "name": "airdropdogs",
    "url": "https://github.com/airdropdogs"
  },
  "contributors": [
    {
      "name": "Automattic, Inc.",
      "email": "support@simplenote.com",
      "url": "https://github.com/Automattic/simplenote-electron"
    }
  ],
  "productName": "1TXT",
  "version": "1.0.7",
  "main": "desktop/index.js",
  "license": "GPL-2.0",
  "homepage": "https://github.com/airdropdogs/1txt",
  "scripts": {
    "dev": "npx cross-env NODE_ENV=development DEV_SERVER=true concurrently -c gray.dim \"npm run dev-server\" \"wait-on http://localhost:4000 && npm run start\"",
    "dev-server": "npx cross-env NODE_ENV=development webpack serve --config ./webpack.config.js --static dist --host 0.0.0.0 --port 4000 --hot",
    "dev:web": "npx cross-env NODE_ENV=development webpack serve --config ./webpack.config.web.js --static dist-web --host 0.0.0.0 --port 4003 --hot",
    "start": "npx cross-env NODE_ENV=development DEV_SERVER=true electron . --inspect --watchDir=./desktop",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,scss,css,json,md}\"",
    "build": "npx cross-env NODE_ENV=production webpack --config ./webpack.config.js",
    "build:web": "npx cross-env NODE_ENV=production webpack --config ./webpack.config.web.js",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win:zip": "npm run build && electron-builder --win zip --x64",
    "build:win:nsis": "npm run build && electron-builder --win nsis --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "pack:win": "electron-builder --win --x64 --dir",
    "deploy": "./bin/deploy.sh",
    "prepare": "git config --local core.hooksPath .githooks",
    "postinstall": "node scripts/patch-electron.js",
    "release": "node scripts/release.js",
    "release:win": "node scripts/release.js --build win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airdropdogs/1txt.git"
  },
  "bugs": {
    "url": "https://github.com/airdropdogs/1txt/issues"
  },
  "keywords": [
    "notes",
    "markdown",
    "electron",
    "supabase",
    "wysiwyg",
    "vditor",
    "simplenote",
    "typora",
    "bring-your-own-backend"
  ],
  "engines": {
    "node": ">= 12.14.1",
    "npm": ">= 6.13.7"
  },
  "browserslist": [
    "> 1%",
    "ie >= 11"
  ],
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
