# 1TXT runtime configuration.
# Copy this file to `.env` and fill in your own Supabase project credentials.
#
# These values override `supabase_url` / `supabase_key` in config.json at
# build time (see webpack.config.js → getConfig()), so you can keep your
# personal credentials out of any tracked config file.
#
# Where to find them:
#   1. Create a project at https://supabase.com
#   2. Settings → API → Project URL  → SUPABASE_URL
#                    → anon / public → SUPABASE_KEY
#   3. Run docs/schema.sql in the SQL Editor to create the required tables.

SUPABASE_URL=
SUPABASE_KEY=
